LOG_LEVEL=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=cim_db
DB_LOG_LEVEL=debug

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8888

# Firebase Configuration
FIREBASE_TEST_USER=test@cim.local
FIREBASE_TEST_PASSWORD=your-password
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Excel Configuration
EXCEL_MAX_ROWS=10000
EXCEL_MAX_COLS=50

# Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT=/path/to/google-service-account.json
INVENTORY_SPREADSHEET_ID=your-inventory-spreadsheet-id

# Testing
TEST_INVENTORY_SPREADSHEET_ID=your-test-inventory-spreadsheet-id
TEST_REVENUE_EXPENSE_SPREADSHEET_ID=your-test-revenue-expense-spreadsheet-id

# Cloudflare R2 Configuration
R2_ENABLED=false
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# File Uploads
UPLOADS_BASE_PATH=uploads
